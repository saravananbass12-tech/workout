password = "".join(secrets.choice(characters) for _ in range(length))

print(password)











import tkinter as tk

def add_value(value):
    display.insert(tk.END, value)

def calculate():
    try:
        result = eval(display.get(), {"__builtins__": {}}, {})
        display.delete(0, tk.END)
        display.insert(0, result)
    except Exception:
        display.delete(0, tk.END)
        display.insert(0, "Error")

root = tk.Tk()
root.title("Calculator")

display = tk.Entry(root, width=25, font=("Arial", 18))
display.grid(row=0, column=0, columnspan=4, padx=10, pady=10)

for number in range(10):
    button = tk.Button(
        root,
        text=str(number),
        width=5,
        command=lambda n=number: add_value(n)
    )
    button.grid(row=(9 - number) // 3 + 1, column=(number - 1) % 3)

tk.Button(root, text="=", width=5, command=calculate).grid(row=5, column=3)
root.mainloop()
